{
  "name": "rohit-auto-print-hub",
  "version": "1.0.0",
  "description": "Automatic Printing Software for Shops",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.rohit.printhub",
    "productName": "Rohit Auto Print Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdf-to-printer": "^5.3.0",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
